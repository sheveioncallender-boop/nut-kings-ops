<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nk_service_area_search" model="ir.ui.view">
        <field name="name">nutkings.service.area.search</field>
        <field name="model">nutkings.service.area</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_nk_service_area_list" model="ir.ui.view">
        <field name="name">nutkings.service.area.list</field>
        <field name="model">nutkings.service.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="customer_ids" widget="many2many_tags"/>
                <field name="truck_ids" widget="many2many_tags"/>
                <field name="user_ids" widget="many2many_tags" groups="nut_kings_ops.group_nutkings_manager,base.group_system"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_nk_service_area_form" model="ir.ui.view">
        <field name="name">nutkings.service.area.form</field>
        <field name="model">nutkings.service.area</field>
        <field name="arch" type="xml">
            <form string="Nut Kings Service Area">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_customers" icon="fa-building">
                            <div class="o_stat_info"><span class="o_stat_text">Customers</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Example: East Trinidad"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="truck_ids" widget="many2many_tags"/>
                            <field name="user_ids" widget="many2many_tags" groups="nut_kings_ops.group_nutkings_manager,base.group_system"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customers">
                            <field name="customer_ids" context="{'default_nk_service_area_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="nk_customer_code"/>
                                    <field name="phone"/>
                                    <field name="nk_route"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes" placeholder="Coverage, delivery days, route notes, or dispatcher guidance..."/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_nk_service_areas" model="ir.actions.act_window">
        <field name="name">Service Areas</field>
        <field name="res_model">nutkings.service.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nk_service_area_search"/>
    </record>

    <record id="view_nk_dispatch_plan_search" model="ir.ui.view">
        <field name="name">nutkings.dispatch.plan.search</field>
        <field name="model">nutkings.dispatch.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="service_area_id"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <filter string="Active Plans" name="active" domain="[('state', 'not in', ('done', 'cancelled'))]"/>
                <filter string="Completed" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Service Area" name="group_area" context="{'group_by': 'service_area_id'}"/>
                <filter string="Truck" name="group_truck" context="{'group_by': 'truck_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Departure Month" name="group_month" context="{'group_by': 'planned_departure:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_nk_dispatch_plan_list" model="ir.ui.view">
        <field name="name">nutkings.dispatch.plan.list</field>
        <field name="model">nutkings.dispatch.plan</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-warning="state in ('ready', 'loading')" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="planned_departure"/>
                <field name="service_area_id"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <field name="analysed_trip_count"/>
                <field name="trip_id" optional="show"/>
                <field name="loading_picking_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nk_dispatch_plan_form" model="ir.ui.view">
        <field name="name">nutkings.dispatch.plan.form</field>
        <field name="model">nutkings.dispatch.plan</field>
        <field name="arch" type="xml">
            <form string="Dispatch Plan">
                <header>
                    <button name="action_generate_rotation" type="object" string="Analyse Sales &amp; Returns" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve Plan" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_create_loading" type="object" string="Create Truck Load" class="oe_highlight" invisible="state != 'ready'"/>
                    <button name="action_reset_draft" type="object" string="Return to Draft" invisible="state not in ('ready', 'cancelled') or loading_picking_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,loading,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_trip" icon="fa-road" invisible="not trip_id">
                            <div class="o_stat_info"><span class="o_stat_text">Distribution Trip</span></div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_loading" icon="fa-truck" invisible="not loading_picking_id">
                            <div class="o_stat_info"><span class="o_stat_text">Truck Load</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Service Assignment">
                            <field name="service_area_id" readonly="state != 'draft'"/>
                            <field name="truck_id" readonly="state != 'draft'"/>
                            <field name="driver_id" readonly="state != 'draft'"/>
                            <field name="team_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                        </group>
                        <group string="Rotation Settings">
                            <field name="planned_departure" readonly="state not in ('draft', 'ready')"/>
                            <field name="history_trip_count" readonly="state != 'draft'"/>
                            <field name="safety_stock_percent" readonly="state != 'draft'"/>
                            <field name="analysed_trip_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="trip_id" invisible="1"/>
                            <field name="loading_picking_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="analysed_trip_count">
                        Run <strong>Analyse Sales &amp; Returns</strong> to review what sold and what returned in this service area. The suggested load is editable before approval.
                    </div>
                    <notebook>
                        <page string="Product Rotation">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-success="rotation_action == 'increase'" decoration-warning="rotation_action == 'reduce'" decoration-danger="rotation_action == 'pause'" decoration-muted="rotation_action == 'manual'">
                                    <field name="selected"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="average_loaded_qty" optional="show"/>
                                    <field name="average_sold_qty" optional="show"/>
                                    <field name="average_returned_qty" optional="show"/>
                                    <field name="sell_through_percent" widget="percentage" optional="show"/>
                                    <field name="rotation_action" widget="badge"/>
                                    <field name="recommended_qty"/>
                                    <field name="planned_qty"/>
                                    <field name="notes" optional="show"/>
                                    <field name="history_loaded_qty" optional="hide"/>
                                    <field name="history_sold_qty" optional="hide"/>
                                    <field name="history_returned_qty" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes" placeholder="Special products, promotions, customer requests, or loading notes..."/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_nk_dispatch_plans" model="ir.actions.act_window">
        <field name="name">Dispatch Plans</field>
        <field name="res_model">nutkings.dispatch.plan</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_nk_dispatch_plan_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="view_nk_partner_service_area" model="ir.ui.view">
        <field name="name">res.partner.form.nutkings.service.area</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="nut_kings_ops.view_partner_form_nk"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='nk_route']" position="after">
                <field name="nk_service_area_id" invisible="not nk_is_customer"/>
            </xpath>
        </field>
    </record>

    <record id="view_nk_truck_service_areas" model="ir.ui.view">
        <field name="name">nutkings.truck.form.service.areas</field>
        <field name="model">nutkings.truck</field>
        <field name="inherit_id" ref="nut_kings_ops.view_nk_truck_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_team_ids']" position="after">
                <field name="service_area_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_nk_trip_service_area" model="ir.ui.view">
        <field name="name">nutkings.trip.form.service.area</field>
        <field name="model">nutkings.trip</field>
        <field name="inherit_id" ref="nut_kings_ops.view_nk_trip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route_name']" position="before">
                <field name="service_area_id" readonly="state in ('loading', 'in_progress', 'reconciliation')"/>
            </xpath>
            <xpath expr="//field[@name='route_name']" position="after">
                <field name="dispatch_plan_id" readonly="1" invisible="not dispatch_plan_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_nk_trip_list_service_area" model="ir.ui.view">
        <field name="name">nutkings.trip.list.service.area</field>
        <field name="model">nutkings.trip</field>
        <field name="inherit_id" ref="nut_kings_ops.view_nk_trip_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route_name']" position="before">
                <field name="service_area_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_nk_trip_search_service_area" model="ir.ui.view">
        <field name="name">nutkings.trip.search.service.area</field>
        <field name="model">nutkings.trip</field>
        <field name="inherit_id" ref="nut_kings_ops.view_nk_trip_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route_name']" position="before"><field name="service_area_id"/></xpath>
            <xpath expr="//filter[@name='group_truck']" position="before"><filter string="Service Area" name="group_service_area" context="{'group_by': 'service_area_id'}"/></xpath>
        </field>
    </record>

    <record id="view_nk_truck_list_service_areas" model="ir.ui.view">
        <field name="name">nutkings.truck.list.service.areas</field>
        <field name="model">nutkings.truck</field>
        <field name="inherit_id" ref="nut_kings_ops.view_nk_truck_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_driver_id']" position="after"><field name="service_area_ids" widget="many2many_tags" optional="show"/></xpath>
        </field>
    </record>

    <record id="view_users_form_nutkings_areas" model="ir.ui.view">
        <field name="name">res.users.form.nutkings.service.areas</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nut Kings Ops" groups="nut_kings_ops.group_nutkings_manager,base.group_system">
                    <group>
                        <field name="nk_service_area_ids" widget="many2many_tags"/>
                    </group>
                    <div class="text-muted">Assign operational roles under Access Rights. Empty service areas allow access to all active service areas.</div>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_nk_dispatch_plans" name="Dispatch Plans &amp; Product Rotation" parent="menu_nk_distribution_root" action="action_nk_dispatch_plans" sequence="5" groups="nut_kings_ops.group_nutkings_dispatcher,nut_kings_ops.group_nutkings_manager,base.group_system"/>
    <menuitem id="menu_nk_service_areas" name="Service Areas" parent="menu_nk_configuration_root" action="action_nk_service_areas" sequence="5" groups="nut_kings_ops.group_nutkings_manager,base.group_system"/>
</odoo>
