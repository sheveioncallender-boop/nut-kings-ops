<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_nk_staff_company" model="ir.rule"><field name="name">Nut Kings Staff: allowed companies</field><field name="model_id" ref="model_nutkings_staff"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_nk_truck_company" model="ir.rule"><field name="name">Nut Kings Trucks: allowed companies</field><field name="model_id" ref="model_nutkings_truck"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_nk_trip_company" model="ir.rule"><field name="name">Nut Kings Trips: allowed companies</field><field name="model_id" ref="model_nutkings_trip"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_nk_trip_line_company" model="ir.rule"><field name="name">Nut Kings Trip Lines: allowed companies</field><field name="model_id" ref="model_nutkings_trip_line"/><field name="domain_force">[('trip_id.company_id', 'in', company_ids)]</field></record>
    <record id="rule_nk_sync_company" model="ir.rule"><field name="name">Nut Kings Sync Events: allowed companies</field><field name="model_id" ref="model_nutkings_sync_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_nk_dashboard_company" model="ir.rule"><field name="name">Nut Kings Dashboard: allowed companies</field><field name="model_id" ref="model_nutkings_backend_dashboard"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_nk_service_area_company" model="ir.rule"><field name="name">Nut Kings Service Areas: allowed companies</field><field name="model_id" ref="model_nutkings_service_area"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_nk_dispatch_plan_company" model="ir.rule"><field name="name">Nut Kings Dispatch Plans: allowed companies</field><field name="model_id" ref="model_nutkings_dispatch_plan"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_nk_dispatch_plan_line_company" model="ir.rule"><field name="name">Nut Kings Dispatch Plan Lines: allowed companies</field><field name="model_id" ref="model_nutkings_dispatch_plan_line"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>

    <record id="rule_nk_truck_dispatcher" model="ir.rule">
        <field name="name">Nut Kings Trucks: dispatcher service areas</field>
        <field name="model_id" ref="model_nutkings_truck"/>
        <field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_dispatcher'))]"/>
        <field name="domain_force">user.nk_service_area_ids and ['|', ('service_area_ids', '=', False), ('service_area_ids', 'in', user.nk_service_area_ids.ids)] or [(1, '=', 1)]</field>
    </record>
    <record id="rule_nk_trip_dispatcher" model="ir.rule">
        <field name="name">Nut Kings Trips: dispatcher service areas</field>
        <field name="model_id" ref="model_nutkings_trip"/>
        <field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_dispatcher'))]"/>
        <field name="domain_force">user.nk_service_area_ids and ['|', ('service_area_id', '=', False), ('service_area_id', 'in', user.nk_service_area_ids.ids)] or [(1, '=', 1)]</field>
    </record>
    <record id="rule_nk_trip_line_dispatcher" model="ir.rule">
        <field name="name">Nut Kings Trip Lines: dispatcher service areas</field>
        <field name="model_id" ref="model_nutkings_trip_line"/>
        <field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_dispatcher'))]"/>
        <field name="domain_force">user.nk_service_area_ids and ['|', ('trip_id.service_area_id', '=', False), ('trip_id.service_area_id', 'in', user.nk_service_area_ids.ids)] or [(1, '=', 1)]</field>
    </record>
    <record id="rule_nk_dispatch_plan_dispatcher" model="ir.rule">
        <field name="name">Nut Kings Dispatch Plans: dispatcher service areas</field>
        <field name="model_id" ref="model_nutkings_dispatch_plan"/>
        <field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_dispatcher'))]"/>
        <field name="domain_force">user.nk_service_area_ids and [('service_area_id', 'in', user.nk_service_area_ids.ids)] or [(1, '=', 1)]</field>
    </record>
    <record id="rule_nk_dispatch_plan_line_dispatcher" model="ir.rule">
        <field name="name">Nut Kings Dispatch Plan Lines: dispatcher service areas</field>
        <field name="model_id" ref="model_nutkings_dispatch_plan_line"/>
        <field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_dispatcher'))]"/>
        <field name="domain_force">user.nk_service_area_ids and [('plan_id.service_area_id', 'in', user.nk_service_area_ids.ids)] or [(1, '=', 1)]</field>
    </record>

    <record id="rule_nk_truck_manager" model="ir.rule"><field name="name">Nut Kings Trucks: management</field><field name="model_id" ref="model_nutkings_truck"/><field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_manager')), (4, ref('base.group_system'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_nk_trip_manager" model="ir.rule"><field name="name">Nut Kings Trips: management</field><field name="model_id" ref="model_nutkings_trip"/><field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_manager')), (4, ref('base.group_system'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_nk_trip_line_manager" model="ir.rule"><field name="name">Nut Kings Trip Lines: management</field><field name="model_id" ref="model_nutkings_trip_line"/><field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_manager')), (4, ref('base.group_system'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_nk_dispatch_plan_manager" model="ir.rule"><field name="name">Nut Kings Dispatch Plans: management</field><field name="model_id" ref="model_nutkings_dispatch_plan"/><field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_manager')), (4, ref('base.group_system'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_nk_dispatch_plan_line_manager" model="ir.rule"><field name="name">Nut Kings Dispatch Plan Lines: management</field><field name="model_id" ref="model_nutkings_dispatch_plan_line"/><field name="groups" eval="[(4, ref('nut_kings_ops.group_nutkings_manager')), (4, ref('base.group_system'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
</odoo>
