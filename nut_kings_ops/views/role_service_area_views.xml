<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutkings_service_area_list" model="ir.ui.view">
        <field name="name">nutkings.service.area.list</field>
        <field name="model">nutkings.service.area</field>
        <field name="arch" type="xml">
            <list string="Van Service Areas" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="van_count"/>
                <field name="trip_count"/>
                <field name="safety_percent"/>
                <field name="minimum_history_trips"/>
                <field name="history_window"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_nutkings_service_area_form" model="ir.ui.view">
        <field name="name">nutkings.service.area.form</field>
        <field name="model">nutkings.service.area</field>
        <field name="arch" type="xml">
            <form string="Van Service Area">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vans" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="van_count" widget="statinfo" string="Vans"/>
                        </button>
                        <button name="action_view_plans" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <field name="dispatch_plan_count" widget="statinfo" string="Demand Plans"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="East, Central, South..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Suggestion Rules">
                            <field name="safety_percent"/>
                            <field name="minimum_history_trips"/>
                            <field name="history_window"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Primary Vans">
                            <field name="van_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="active" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="description" placeholder="Describe the route, customer mix and product-selection considerations for this service area..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nutkings_service_area_search" model="ir.ui.view">
        <field name="name">nutkings.service.area.search</field>
        <field name="model">nutkings.service.area</field>
        <field name="arch" type="xml">
            <search string="Service Areas">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nutkings_service_area" model="ir.actions.act_window">
        <field name="name">Van Service Areas</field>
        <field name="res_model">nutkings.service.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nutkings_service_area_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create each van service area.</p>
            <p>Demand recommendations are calculated separately for each service area from its own sales and returns.</p>
        </field>
    </record>

    <record id="view_nutkings_dispatch_plan_list" model="ir.ui.view">
        <field name="name">nutkings.dispatch.plan.list</field>
        <field name="model">nutkings.dispatch.plan</field>
        <field name="arch" type="xml">
            <list string="Van Load Demand Plans" decoration-info="state == 'review'" decoration-success="state in ('approved', 'used')" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="truck_id"/>
                <field name="service_area_id"/>
                <field name="generated_at"/>
                <field name="history_trip_count"/>
                <field name="suggested_total_qty" sum="Suggested"/>
                <field name="actual_total_qty" sum="Actual"/>
                <field name="warehouse_shortage_line_count" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_nutkings_dispatch_plan_form" model="ir.ui.view">
        <field name="name">nutkings.dispatch.plan.form</field>
        <field name="model">nutkings.dispatch.plan</field>
        <field name="arch" type="xml">
            <form string="Van Load Demand Plan">
                <header>
                    <button name="action_generate_suggestions" string="Generate / Refresh Suggestions" type="object" class="oe_highlight" invisible="state in ('approved', 'used', 'cancelled')"/>
                    <button name="action_use_suggested_quantities" string="Use Suggested Quantities" type="object" invisible="state not in ('draft', 'review')"/>
                    <button name="action_approve" string="Approve for Loading" type="object" class="oe_highlight" invisible="state != 'review'"/>
                    <button name="action_mark_used" string="Mark Loaded / Used" type="object" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('used', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved,used,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="truck_id" readonly="state in ('approved', 'used', 'cancelled')"/>
                            <field name="service_area_id" readonly="state in ('approved', 'used', 'cancelled')"/>
                            <field name="trip_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Demand Calculation">
                            <field name="history_window" readonly="state in ('approved', 'used', 'cancelled')"/>
                            <field name="minimum_history_trips" readonly="state in ('approved', 'used', 'cancelled')"/>
                            <field name="safety_percent" readonly="state in ('approved', 'used', 'cancelled')"/>
                            <field name="history_trip_count"/>
                            <field name="insufficient_history"/>
                        </group>
                    </group>
                    <group string="Load Totals">
                        <field name="suggested_total_qty"/>
                        <field name="actual_total_qty"/>
                        <field name="warehouse_shortage_line_count"/>
                        <field name="generated_at"/>
                        <field name="generated_by_id"/>
                    </group>
                    <notebook>
                        <page string="Product Selection &amp; Quantities">
                            <field name="line_ids" readonly="state in ('used', 'cancelled')">
                                <list editable="bottom" decoration-danger="warehouse_shortage" decoration-warning="recommendation_status == 'reduce'" decoration-success="recommendation_status == 'increase'">
                                    <field name="product_id"/>
                                    <field name="current_van_qty"/>
                                    <field name="last_loaded_qty" optional="show"/>
                                    <field name="last_sold_qty"/>
                                    <field name="last_returned_qty"/>
                                    <field name="weighted_average_sold"/>
                                    <field name="return_rate" optional="show"/>
                                    <field name="stockout_rate" optional="show"/>
                                    <field name="warehouse_available_qty"/>
                                    <field name="suggested_load_qty"/>
                                    <field name="actual_load_qty"/>
                                    <field name="variance_from_suggestion" optional="show"/>
                                    <field name="recommendation_status" widget="badge"/>
                                    <field name="recommendation_reason" optional="show"/>
                                    <field name="dispatcher_note" optional="show"/>
                                    <field name="warehouse_shortage" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Dispatcher or manager notes for this van load..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nutkings_dispatch_plan_search" model="ir.ui.view">
        <field name="name">nutkings.dispatch.plan.search</field>
        <field name="model">nutkings.dispatch.plan</field>
        <field name="arch" type="xml">
            <search string="Demand Plans">
                <field name="name"/>
                <field name="truck_id"/>
                <field name="service_area_id"/>
                <field name="trip_id"/>
                <field name="state"/>
                <filter name="to_review" string="To Review" domain="[('state', '=', 'review')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="used" string="Used" domain="[('state', '=', 'used')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_van" string="Van" context="{'group_by': 'truck_id'}"/>
                    <filter name="group_area" string="Service Area" context="{'group_by': 'service_area_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'generated_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nutkings_dispatch_plan" model="ir.actions.act_window">
        <field name="name">Service Area Load Planning</field>
        <field name="res_model">nutkings.dispatch.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nutkings_dispatch_plan_search"/>
        <field name="context">{'search_default_to_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate the next product mix and load quantities for a van.</p>
            <p>The calculation uses recent sales, returns, van stock and Finished Goods availability for the selected service area.</p>
        </field>
    </record>

    <record id="view_nutkings_dispatch_plan_line_pivot" model="ir.ui.view">
        <field name="name">nutkings.dispatch.plan.line.pivot</field>
        <field name="model">nutkings.dispatch.plan.line</field>
        <field name="arch" type="xml">
            <pivot string="Product Demand by Service Area">
                <field name="service_area_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="truck_id" type="col"/>
                <field name="last_sold_qty" type="measure"/>
                <field name="last_returned_qty" type="measure"/>
                <field name="weighted_average_sold" type="measure"/>
                <field name="suggested_load_qty" type="measure"/>
                <field name="actual_load_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_nutkings_dispatch_plan_line_graph" model="ir.ui.view">
        <field name="name">nutkings.dispatch.plan.line.graph</field>
        <field name="model">nutkings.dispatch.plan.line</field>
        <field name="arch" type="xml">
            <graph string="Suggested vs Actual Van Loads" type="bar">
                <field name="service_area_id"/>
                <field name="suggested_load_qty" type="measure"/>
                <field name="actual_load_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_nutkings_area_demand_analysis" model="ir.actions.act_window">
        <field name="name">Service Area Product Demand</field>
        <field name="res_model">nutkings.dispatch.plan.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'group_by': ['service_area_id', 'product_id']}</field>
        <field name="help" type="html">
            <p>Compare sales, returns, recommendations and actual van loads by service area and product.</p>
        </field>
    </record>

    
    <record id="view_nutkings_truck_form_service_area" model="ir.ui.view">
        <field name="name">nutkings.truck.form.service.area</field>
        <field name="model">nutkings.truck</field>
        <field name="inherit_id" ref="nut_kings_ops.view_nk_truck_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Service Area Demand Planning">
                    <field name="primary_service_area_id"/>
                    <field name="service_area_notes" placeholder="Products or route notes specific to this van's primary service area..."/>
                    <button name="action_create_demand_plan" type="object" string="Generate Next Load Suggestions" class="oe_highlight" icon="fa-magic"/>
                    <button name="action_view_dispatch_plans" type="object" string="Demand Plan History" icon="fa-line-chart"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_nutkings_trip_form_service_area" model="ir.ui.view">
        <field name="name">nutkings.trip.form.service.area</field>
        <field name="model">nutkings.trip</field>
        <field name="inherit_id" ref="nut_kings_ops.view_nk_trip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Van Service Area &amp; Demand Plan">
                    <field name="service_area_id" required="1"/>
                    <field name="dispatch_plan_id" readonly="1"/>
                    <button name="action_generate_demand_plan" type="object" string="Generate / Refresh Load Suggestions" class="oe_highlight" icon="fa-magic"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_nutkings_roles" model="ir.ui.view">
        <field name="name">res.users.form.nutkings.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nut Kings Ops Roles" groups="base.group_system">
                    <div class="alert alert-info" role="alert">
                        Assign only the workflow(s) this login should perform. A Manager / Administrator receives all Nut Kings operational roles.
                    </div>
                    <group>
                        <group string="Warehouse Roles">
                            <field name="nutkings_role_office_receiving"/>
                            <field name="nutkings_role_raw_material_issue"/>
                            <field name="nutkings_role_finished_goods_entry"/>
                        </group>
                        <group string="Distribution &amp; Management">
                            <field name="nutkings_role_dispatcher"/>
                            <field name="nutkings_role_manager"/>
                            <field name="nutkings_role_summary" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_nutkings_roles" model="ir.ui.view">
        <field name="name">res.company.form.nutkings.roles</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nut Kings Ops">
                    <div class="alert alert-warning" role="alert" invisible="nutkings_role_enforcement_enabled">
                        Assign and test all employee roles before enabling enforcement. Settings administrators always retain full access.
                    </div>
                    <group>
                        <group string="Role Enforcement">
                            <field name="nutkings_role_enforcement_enabled"/>
                            <field name="nutkings_require_service_area_on_dispatch"/>
                            <field name="nutkings_finished_goods_location_id"/>
                        </group>
                        <group string="Default Demand Recommendation Rules">
                            <field name="nutkings_history_window"/>
                            <field name="nutkings_min_history_trips"/>
                            <field name="nutkings_default_safety_percent"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_nutkings_service_area" model="ir.ui.view">
        <field name="name">stock.picking.form.nutkings.service.area</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Nut Kings Van / Service Area" invisible="not nutkings_van_id and not nutkings_service_area_id and not nutkings_dispatch_plan_id">
                    <field name="nutkings_van_id"/>
                    <field name="nutkings_service_area_id"/>
                    <field name="nutkings_dispatch_plan_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_nutkings_service_area" name="Van Service Areas" parent="menu_nk_root" action="action_nutkings_service_area" sequence="71" groups="nut_kings_ops.group_nutkings_manager,nut_kings_ops.group_nutkings_dispatcher"/>
    <menuitem id="menu_nutkings_dispatch_plan" name="Service Area Load Planning" parent="menu_nk_root" action="action_nutkings_dispatch_plan" sequence="72" groups="nut_kings_ops.group_nutkings_manager,nut_kings_ops.group_nutkings_dispatcher"/>
    <menuitem id="menu_nutkings_area_demand_analysis" name="Service Area Product Demand" parent="menu_nk_root" action="action_nutkings_area_demand_analysis" sequence="91" groups="nut_kings_ops.group_nutkings_manager,nut_kings_ops.group_nutkings_dispatcher"/>
</odoo>
